---
// component imports arrive with the tasks that first use them
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Caira: one message, fully traced | Rocky G</title>
    <meta
      name="description"
      content="A patient texts a clinic and has a confirmed appointment about 1.6 seconds later, and the AI was never allowed to invent a fact. The animated tour of Caira, a WhatsApp AI receptionist a hospital can trust."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ======================================================================
     DESIGN TOKENS
     ====================================================================== */
      :root {
        --ink: #090d12; /* canvas */
        --ink-2: #0f151d; /* raised */
        --ink-3: #141c26; /* cards */
        --ink-4: #1a2430; /* inset */
        --line: #212d3a; /* hairline */
        --line-2: #2c3a49;
        --text: #dce5ee; /* primary */
        --muted: #8b99a8; /* secondary */
        --faint: #5e6c7b; /* tertiary */

        --teal: #34e4ce; /* system / AI path */
        --teal-dim: #0f3b38;
        --amber: #f5b54a; /* cost / latency / money */
        --amber-dim: #3a2c10;
        --wa: #25d366; /* WhatsApp — chat + "free" only */
        --wa-dim: #123322;
        --red: #ff6076; /* failure / handoff */
        --red-dim: #3a1620;
        --violet: #a78bfa; /* plain-English track */
        --violet-dim: #241c3d;

        --radius: 14px;
        --maxw: 58rem;
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
        --disp: "Space Grotesk", system-ui, sans-serif;
        --body: "Inter", system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--text);
        font-family: var(--body);
        font-size: 18px;
        line-height: 1.72;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        background-image:
          radial-gradient(
            60rem 40rem at 82% -8%,
            rgba(52, 228, 206, 0.06),
            transparent 60%
          ),
          radial-gradient(
            50rem 40rem at -10% 8%,
            rgba(245, 181, 74, 0.045),
            transparent 55%
          );
        background-attachment: fixed;
      }
      ::selection {
        background: rgba(52, 228, 206, 0.28);
        color: #fff;
      }

      #caira-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        z-index: 60;
        background: linear-gradient(90deg, var(--teal), var(--amber));
        box-shadow: 0 0 12px rgba(52, 228, 206, 0.6);
      }

      /* ======================================================================
     LAYOUT
     ====================================================================== */
      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 1.4rem;
      }
      .sec {
        padding-block: 3.2rem;
        border-top: 1px solid var(--line);
      }
      .sec:first-of-type {
        border-top: none;
      }

      /* ======================================================================
     TYPE
     ====================================================================== */
      h1,
      h2,
      h3,
      h4 {
        font-family: var(--disp);
        font-weight: 600;
        line-height: 1.14;
        letter-spacing: -0.02em;
        margin: 0;
      }
      h2 {
        font-size: clamp(1.5rem, 3.4vw, 2.15rem);
        margin-bottom: 0.5rem;
      }
      h3 {
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        margin: 2.3rem 0 0.6rem;
        color: #eaf1f7;
      }
      h4 {
        font-size: 1rem;
        font-weight: 500;
        margin: 1.7rem 0 0.4rem;
        color: #c7d2dd;
      }
      p {
        margin: 0 0 1.05rem;
        color: #c7d2dd;
      }
      p.lead {
        font-size: 1.16rem;
        color: var(--text);
      }
      a {
        color: var(--teal);
        text-decoration: none;
        border-bottom: 1px solid rgba(52, 228, 206, 0.3);
      }
      strong {
        color: #eaf1f7;
        font-weight: 600;
      }
      em.tt {
        font-style: normal;
        font-family: var(--mono);
        font-size: 0.9em;
        color: var(--teal);
        background: rgba(52, 228, 206, 0.08);
        padding: 0.05em 0.38em;
        border-radius: 5px;
        border: 1px solid rgba(52, 228, 206, 0.15);
      }
      .eyebrow {
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--teal);
        margin: 0 0 1rem;
      }
      .secnum {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--amber);
        letter-spacing: 0.1em;
      }
      .tiny {
        font-size: 0.88rem;
        color: var(--muted);
      }

      /* ======================================================================
     "IN PLAIN ENGLISH" CARD — the parallel track for non-engineers
     ====================================================================== */
      .plain {
        position: relative;
        margin: 1.3rem 0 1.6rem;
        padding: 1.15rem 1.25rem 1.15rem 1.35rem;
        border: 1px solid rgba(167, 139, 250, 0.28);
        border-left: 3px solid var(--violet);
        border-radius: 0 14px 14px 0;
        background: linear-gradient(
          100deg,
          rgba(167, 139, 250, 0.09),
          rgba(167, 139, 250, 0.02) 65%,
          transparent
        );
      }
      .plain .lbl {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #c4b5fd;
        margin-bottom: 0.5rem;
      }
      .plain .lbl::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--violet);
        box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.18);
      }
      .plain p {
        color: #ddd6fe;
        font-size: 1.02rem;
        margin: 0 0 0.7rem;
      }
      .plain p:last-child {
        margin-bottom: 0;
      }
      .plain strong {
        color: #f3eeff;
      }
      .plain .analogy {
        font-style: italic;
        color: #c4b5fd;
      }

      /* ======================================================================
     PART DIVIDERS
     ====================================================================== */
      .partdiv {
        margin: 4.4rem 0 0;
        padding: 2.4rem 0 0;
        border-top: 1px solid var(--line-2);
        text-align: center;
      }
      .partdiv .n {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--amber);
      }
      .partdiv h2 {
        font-size: clamp(1.7rem, 4.6vw, 2.6rem);
        font-weight: 700;
        margin: 0.5rem 0 0.5rem;
      }
      .partdiv p {
        max-width: 44ch;
        margin: 0 auto;
        color: var(--muted);
        font-size: 0.98rem;
      }
      .partdiv .rule {
        width: 56px;
        height: 2px;
        margin: 1.4rem auto 0;
        background: linear-gradient(90deg, var(--teal), var(--amber));
      }

      /* ======================================================================
     HERO
     ====================================================================== */
      header.hero {
        padding: 3.4rem 0 2.4rem;
        position: relative;
      }
      .kicker {
        display: inline-flex;
        gap: 0.6rem;
        align-items: center;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        border: 1px solid var(--line-2);
        border-radius: 100px;
        padding: 0.42rem 0.85rem;
        margin-bottom: 1.6rem;
      }
      .kicker b {
        color: var(--teal);
        font-weight: 500;
      }
      header.hero h1 {
        font-size: clamp(2.2rem, 6.2vw, 4.2rem);
        font-weight: 700;
        max-width: 17ch;
      }
      header.hero .sub {
        font-size: clamp(1.05rem, 2.2vw, 1.26rem);
        color: var(--muted);
        max-width: 54ch;
        margin: 1.3rem 0 0;
        line-height: 1.56;
      }
      .byline {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.9rem;
        align-items: center;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--faint);
      }
      .chip {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: #b7c4d1;
        background: var(--ink-3);
        border: 1px solid var(--line-2);
        border-radius: 7px;
        padding: 0.28rem 0.55rem;
        white-space: nowrap;
      }
      .chip.dot::before {
        content: "";
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--teal);
        margin-right: 0.45rem;
        vertical-align: middle;
      }

      /* ---------- signature: the traced message ------------------------------ */
      .trace {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 0;
        margin: 2.6rem 0 0.4rem;
        background: linear-gradient(180deg, var(--ink-2), var(--ink));
        border: 1px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.9);
      }
      .trace-head {
        grid-column: 1/-1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--ink-2);
      }
      .trace-head .lights {
        display: flex;
        gap: 0.4rem;
      }
      .trace-head .lights i {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: block;
        opacity: 0.8;
      }
      .trace-head .lights i:nth-child(1) {
        background: #ff5f57;
      }
      .trace-head .lights i:nth-child(2) {
        background: #febc2e;
      }
      .trace-head .lights i:nth-child(3) {
        background: #28c840;
      }
      .trace-head span {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--faint);
        margin-left: 0.3rem;
      }
      .chat {
        padding: 1.3rem 1.15rem;
        border-right: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        justify-content: center;
      }
      .bubble {
        max-width: 88%;
        padding: 0.6rem 0.8rem;
        border-radius: 13px;
        font-size: 0.92rem;
        line-height: 1.42;
        position: relative;
      }
      .bubble.in {
        align-self: flex-start;
        background: #132b1f;
        border: 1px solid var(--wa-dim);
        color: #dff4e7;
        border-bottom-left-radius: 4px;
      }
      .bubble.in::after {
        content: "";
        position: absolute;
        left: -6px;
        bottom: 0;
        width: 12px;
        height: 12px;
        background: #132b1f;
        border-left: 1px solid var(--wa-dim);
        border-bottom: 1px solid var(--wa-dim);
        clip-path: polygon(0 100%, 100% 100%, 100% 0);
      }
      .bubble.out {
        align-self: flex-end;
        background: var(--ink-4);
        border: 1px solid var(--line-2);
        color: #dce5ee;
        border-bottom-right-radius: 4px;
      }
      .bubble .t {
        display: block;
        font-family: var(--mono);
        font-size: 0.62rem;
        color: var(--faint);
        margin-top: 0.35rem;
        text-align: right;
      }
      .later {
        align-self: center;
        font-family: var(--mono);
        font-size: 0.64rem;
        color: var(--faint);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0.2rem 0;
      }
      .trace-body {
        padding: 1.3rem 1.15rem;
        font-family: var(--mono);
        font-size: 0.76rem;
        line-height: 1.5;
        position: relative;
      }
      .trace-body .spine {
        position: absolute;
        left: 1.55rem;
        top: 1.7rem;
        bottom: 1.6rem;
        width: 2px;
        background: linear-gradient(
          180deg,
          var(--teal),
          rgba(52, 228, 206, 0.15)
        );
      }
      .hop {
        position: relative;
        padding: 0.28rem 0 0.28rem 1.6rem;
        color: #aebbc8;
      }
      .hop::before {
        content: "";
        position: absolute;
        left: calc(1.55rem - 1.15rem);
        top: 0.62rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--ink);
        border: 2px solid var(--teal);
        box-shadow: 0 0 0 3px var(--ink);
      }
      .hop b {
        color: var(--teal);
        font-weight: 500;
      }
      .hop .k {
        color: var(--faint);
      }
      .hop .cost {
        color: var(--amber);
      }
      .hop .ms {
        color: #93a2b1;
      }
      .hop.hit::before {
        border-color: var(--amber);
      }
      .hop.hit b {
        color: var(--amber);
      }
      #trace-runner {
        position: absolute;
        left: calc(1.55rem - 3px);
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 14px 3px rgba(52, 228, 206, 0.8);
        top: 1.7rem;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.1rem;
        margin: 1.6rem 0 0;
        padding: 0.9rem 1.1rem;
        background: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: 12px;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--muted);
      }
      .legend b {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: #c7d2dd;
        font-weight: 400;
      }
      .legend b i {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: block;
      }

      /* ======================================================================
     CONTENT COMPONENTS
     ====================================================================== */
      ul.clean {
        margin: 0.2rem 0 1.2rem;
        padding-left: 0;
        list-style: none;
      }
      ul.clean li {
        position: relative;
        padding-left: 1.5rem;
        margin: 0.5rem 0;
        color: #c7d2dd;
      }
      ul.clean li::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: var(--teal);
        font-size: 0.85em;
        top: 0.05em;
      }
      ul.clean.violet li::before {
        color: var(--violet);
      }

      ol.steps {
        margin: 0.2rem 0 1.2rem;
        padding-left: 0;
        list-style: none;
        counter-reset: s;
      }
      ol.steps li {
        counter-increment: s;
        position: relative;
        padding-left: 2.4rem;
        margin: 0.85rem 0;
        color: #c7d2dd;
      }
      ol.steps li::before {
        content: counter(s, decimal-leading-zero);
        position: absolute;
        left: 0;
        top: 0.1em;
        font-family: var(--mono);
        font-size: 0.74rem;
        color: var(--amber);
        border: 1px solid var(--line-2);
        border-radius: 6px;
        padding: 0.05rem 0.35rem;
        background: var(--ink-2);
      }

      .callout {
        border: 1px solid var(--line-2);
        border-left: 3px solid var(--teal);
        background: linear-gradient(
          90deg,
          rgba(52, 228, 206, 0.05),
          transparent 70%
        );
        border-radius: 0 12px 12px 0;
        padding: 1rem 1.15rem;
        margin: 1.4rem 0;
        font-size: 0.96rem;
        color: #c7d2dd;
      }
      .callout.amber {
        border-left-color: var(--amber);
        background: linear-gradient(
          90deg,
          rgba(245, 181, 74, 0.06),
          transparent 70%
        );
      }
      .callout.red {
        border-left-color: var(--red);
        background: linear-gradient(
          90deg,
          rgba(255, 96, 118, 0.06),
          transparent 70%
        );
      }
      .callout.green {
        border-left-color: var(--wa);
        background: linear-gradient(
          90deg,
          rgba(37, 211, 102, 0.06),
          transparent 70%
        );
      }
      .callout .lbl {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--teal);
        display: block;
        margin-bottom: 0.35rem;
      }
      .callout.amber .lbl {
        color: var(--amber);
      }
      .callout.red .lbl {
        color: var(--red);
      }
      .callout.green .lbl {
        color: var(--wa);
      }

      .estimate {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--amber);
        border: 1px solid rgba(245, 181, 74, 0.3);
        background: rgba(245, 181, 74, 0.07);
        border-radius: 5px;
        padding: 0.1rem 0.4rem;
        vertical-align: middle;
      }

      /* ---------- tables ------------------------------------------------------ */
      .tablewrap {
        overflow-x: auto;
        margin: 1.4rem 0;
        border: 1px solid var(--line);
        border-radius: 12px;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.84rem;
        min-width: 34rem;
      }
      th,
      td {
        text-align: left;
        padding: 0.6rem 0.8rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      thead th {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        background: var(--ink-3);
        font-weight: 500;
        position: sticky;
        top: 0;
      }
      tbody tr:last-child td {
        border-bottom: none;
      }
      tbody tr:hover {
        background: rgba(52, 228, 206, 0.03);
      }
      td code,
      th code {
        font-family: var(--mono);
        font-size: 0.92em;
        color: var(--teal);
      }
      td .free {
        color: var(--wa);
        font-family: var(--mono);
      }
      td .paid {
        color: var(--amber);
        font-family: var(--mono);
      }
      td.num {
        font-family: var(--mono);
        text-align: right;
        white-space: nowrap;
      }
      tbody th {
        font-weight: 500;
        color: #eaf1f7;
      }
      .tablecap {
        font-family: var(--mono);
        font-size: 0.68rem;
        color: var(--faint);
        margin: -0.7rem 0 1.4rem;
        padding-left: 0.2rem;
      }

      /* ---------- figures / diagrams ------------------------------------------ */
      .fig {
        margin: 1.6rem 0;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--ink-2);
        padding: 1.3rem;
        overflow: hidden;
      }
      .figcap {
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--faint);
        margin-top: 0.9rem;
        text-align: center;
        line-height: 1.5;
      }
      svg {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
      }

      /* animated edges — the flexibility Markdown/mermaid can't give you */
      @keyframes dash {
        to {
          stroke-dashoffset: -24;
        }
      }
      .flow-dash {
        stroke-dasharray: 5 5;
        animation: dash 1.1s linear infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 0.35;
        }
        50% {
          opacity: 1;
        }
      }
      .pulse {
        animation: pulse 2.4s ease-in-out infinite;
      }

      /* ---------- stat row ---------------------------------------------------- */
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.8rem;
        margin: 1.8rem 0;
      }
      .stats.three {
        grid-template-columns: repeat(3, 1fr);
      }
      .stat {
        background: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1rem;
      }
      .stat .n {
        font-family: var(--disp);
        font-size: 1.65rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--teal);
      }
      .stat .n.amber {
        color: var(--amber);
      }
      .stat .n.violet {
        color: var(--violet);
      }
      .stat .n.sm {
        font-size: 1.25rem;
      }
      .stat .l {
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-top: 0.2rem;
        line-height: 1.4;
      }

      /* ---------- latency budget bars ----------------------------------------- */
      .budget {
        margin: 1.5rem 0;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--ink-2);
        padding: 1.1rem 1.2rem;
      }
      .brow {
        display: grid;
        grid-template-columns: 11rem 1fr 4.2rem;
        gap: 0.7rem;
        align-items: center;
        margin: 0.5rem 0;
        font-size: 0.84rem;
      }
      .brow .nm {
        font-family: var(--mono);
        font-size: 0.74rem;
        color: #b7c4d1;
      }
      .brow .track {
        height: 16px;
        background: var(--ink-4);
        border-radius: 5px;
        overflow: hidden;
        border: 1px solid var(--line);
      }
      .brow .bar {
        height: 100%;
        border-radius: 4px;
        background: linear-gradient(90deg, var(--teal), #1fa898);
        transform-origin: left;
        animation: grow 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      .brow .bar.amber {
        background: linear-gradient(90deg, var(--amber), #b9821f);
      }
      .brow .bar.faint {
        background: linear-gradient(90deg, var(--line-2), #334455);
      }
      .brow .v {
        font-family: var(--mono);
        font-size: 0.74rem;
        color: var(--amber);
        text-align: right;
      }
      @keyframes grow {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      .budget .tot {
        display: flex;
        justify-content: space-between;
        margin-top: 0.9rem;
        padding-top: 0.7rem;
        border-top: 1px dashed var(--line-2);
        font-family: var(--mono);
        font-size: 0.76rem;
        color: var(--muted);
      }
      .budget .tot b {
        color: var(--teal);
      }

      /* ---------- scaling ladder ---------------------------------------------- */
      .ladder {
        margin: 1.6rem 0;
        display: grid;
        gap: 0.7rem;
      }
      .rung {
        display: grid;
        grid-template-columns: 7.5rem 1fr;
        gap: 1rem;
        border: 1px solid var(--line);
        border-left: 3px solid var(--line-2);
        border-radius: 0 12px 12px 0;
        background: var(--ink-2);
        padding: 0.9rem 1.05rem;
      }
      .rung:nth-child(1) {
        border-left-color: var(--wa);
      }
      .rung:nth-child(2) {
        border-left-color: var(--teal);
      }
      .rung:nth-child(3) {
        border-left-color: var(--amber);
      }
      .rung:nth-child(4) {
        border-left-color: var(--red);
      }
      .rung .sz {
        font-family: var(--disp);
        font-size: 1.05rem;
        font-weight: 600;
        color: #eaf1f7;
        letter-spacing: -0.01em;
      }
      .rung .sz small {
        display: block;
        font-family: var(--mono);
        font-size: 0.62rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--faint);
        margin-top: 0.15rem;
      }
      .rung .bd {
        font-size: 0.9rem;
        color: #c7d2dd;
      }
      .rung .bd b {
        color: #eaf1f7;
      }
      .rung .bd .breaks {
        display: block;
        margin-top: 0.4rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--amber);
      }

      /* ---------- two column -------------------------------------------------- */
      .grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin: 1.4rem 0;
      }
      .card {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--ink-2);
        padding: 1rem 1.1rem;
      }
      .card h4 {
        margin: 0 0 0.4rem;
      }
      .card p {
        font-size: 0.9rem;
        margin: 0 0 0.5rem;
      }
      .card p:last-child {
        margin: 0;
      }

      /* ---------- footer ------------------------------------------------------ */
      footer {
        padding: 3rem 0 4rem;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: 0.86rem;
      }
      footer .mono {
        font-family: var(--mono);
        font-size: 0.74rem;
      }

      /* ---------- reveal / motion -------------------------------------------- */
      .reveal {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.7s ease,
          transform 0.7s ease;
      }
      .reveal.in {
        opacity: 1;
        transform: none;
      }

      /* ---------- responsive -------------------------------------------------- */
      @media (max-width: 820px) {
        .grid2 {
          grid-template-columns: 1fr;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .stats.three {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 760px) {
        body {
          font-size: 16.5px;
        }
        .trace {
          grid-template-columns: 1fr;
        }
        .chat {
          border-right: none;
          border-bottom: 1px solid var(--line);
        }
        nav.toc ol {
          grid-template-columns: 1fr;
        }
        header.hero {
          padding: 2.4rem 0 1.6rem;
        }
        .brow {
          grid-template-columns: 8rem 1fr 3.6rem;
        }
        .rung {
          grid-template-columns: 1fr;
        }
        .modebar .hint {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
        #trace-runner {
          display: none;
        }
        .flow-dash,
        .pulse,
        .brow .bar {
          animation: none;
        }
      }

      .homelink {
        display: inline-block;
        margin: 1.2rem 0 0;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--muted);
        border-bottom: none;
      }
      .homelink:hover {
        color: var(--teal);
      }

      /* nerd box */
      .nerdbox {
        margin: 1.4rem 0;
        border: 1px solid var(--line-2);
        border-radius: 12px;
        background: var(--ink-2);
        overflow: hidden;
      }
      .nerdbox summary {
        cursor: pointer;
        list-style: none;
        padding: 0.75rem 1rem;
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--amber);
      }
      .nerdbox summary::-webkit-details-marker {
        display: none;
      }
      .nerdbox[open] summary {
        border-bottom: 1px solid var(--line);
      }
      .nerdbox .nb-body {
        padding: 0.9rem 1.1rem;
        font-size: 0.92rem;
      }

      /* playground chrome (dark adaptation of skills-deck controls) */
      .play {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--ink-2);
        padding: 1.1rem 1.2rem;
        margin: 1.4rem 0;
      }
      .play-label {
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--amber);
        margin-bottom: 0.8rem;
      }
      .btn {
        appearance: none;
        border: 1px solid var(--line-2);
        border-radius: 9px;
        background: var(--ink-3);
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.78rem;
        padding: 0.55rem 0.95rem;
        cursor: pointer;
        transition: all 0.18s;
      }
      .btn:hover {
        border-color: var(--teal);
        color: var(--teal);
      }
      .btn.primary {
        background: var(--teal-dim);
        border-color: rgba(52, 228, 206, 0.4);
        color: var(--teal);
      }
      .play input[type="text"],
      .play textarea {
        width: 100%;
        box-sizing: border-box;
        background: var(--ink-4);
        border: 1px solid var(--line-2);
        border-radius: 9px;
        color: var(--text);
        font-family: var(--body);
        font-size: 0.92rem;
        padding: 0.6rem 0.8rem;
      }
      .play input[type="text"]:focus,
      .play textarea:focus {
        outline: none;
        border-color: var(--teal);
      }
      .play input[type="range"] {
        width: 100%;
        accent-color: var(--amber);
      }
      .playlog {
        font-family: var(--mono);
        font-size: 0.74rem;
        line-height: 1.7;
        background: var(--ink-4);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 0.8rem 0.9rem;
        min-height: 6.5rem;
        margin-top: 0.8rem;
        color: #aebbc8;
      }
      .playlog div {
        opacity: 0;
        animation: pop 0.4s forwards;
      }
      @keyframes pop {
        to {
          opacity: 1;
        }
      }
      .playlog .amber {
        color: var(--amber);
      }
      .playlog .teal {
        color: var(--teal);
      }
      .chunk {
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--line-2);
        border-radius: 9px;
        margin-top: 0.55rem;
        font-size: 0.88rem;
        color: #c7d2dd;
        transition: all 0.3s;
        background: var(--ink-3);
      }
      .chunk.win {
        border-color: var(--teal);
        background: var(--teal-dim);
        transform: scale(1.02);
      }
      .chunk .sc {
        float: right;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--faint);
      }
      .chunk.win .sc {
        color: var(--teal);
      }
      .badge {
        display: inline-block;
        min-width: 3.2rem;
        text-align: center;
        font-family: var(--mono);
        font-size: 0.62rem;
        font-weight: 700;
        padding: 0.18rem 0.5rem;
        border-radius: 999px;
        margin-right: 0.55rem;
      }
      .badge.wait {
        background: var(--ink-4);
        color: var(--faint);
      }
      .badge.pass {
        background: var(--wa-dim);
        color: var(--wa);
      }
      .badge.fail {
        background: var(--red-dim);
        color: var(--red);
      }
      .eval-row {
        padding: 0.42rem 0;
        font-size: 0.9rem;
        border-bottom: 1px dashed var(--line);
        color: #c7d2dd;
      }
      .eval-row:last-child {
        border-bottom: none;
      }
      .scorebar {
        height: 12px;
        border-radius: 999px;
        background: var(--ink-4);
        overflow: hidden;
        margin-top: 0.8rem;
      }
      .scorebar > div {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--teal), var(--wa));
        width: 0;
        transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .bignum {
        font-family: var(--disp);
        font-size: clamp(1.6rem, 3.5vw, 2.2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .mem-smart {
        color: var(--teal);
      }
      @media (prefers-reduced-motion: reduce) {
        .playlog div {
          opacity: 1;
          animation: none;
        }
        .chunk.win {
          transform: none;
        }
      }
    </style>
  </head>
  <body class="caira">
    <div id="caira-progress"></div>
    <div class="wrap">
      <a class="homelink" href="/">← rockyg.me</a>
      <!-- Task 2+: sections mount here, in order -->
    </div>
    <script is:inline>
      (() => {
        const $ = id => document.getElementById(id);
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        /* scroll progress */
        const bar = $("caira-progress");
        if (bar) {
          const onScroll = () => {
            const h = document.documentElement;
            bar.style.width =
              (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100 + "%";
          };
          document.addEventListener("scroll", onScroll, { passive: true });
          onScroll();
        }

        /* reveal on scroll */
        const revealEls = document.querySelectorAll(".reveal");
        if (!reduce && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            entries => {
              entries.forEach(e => {
                if (e.isIntersecting) {
                  e.target.classList.add("in");
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.08 }
          );
          revealEls.forEach(el => io.observe(el));
        } else {
          revealEls.forEach(el => el.classList.add("in"));
        }

        /* === PLAYGROUND BLOCKS: tasks 2, 5, 6, 7 append below this line === */
      })();
    </script>
  </body>
</html>
