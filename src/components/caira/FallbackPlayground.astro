---

---

<div class="reveal play">
  <div class="play-label">▶ Playground: break the AI</div>
  <label style="display:flex;gap:.6rem;align-items:center;font-size:.92rem">
    <input type="checkbox" id="gemini-up" checked /> 💚 Primary model is healthy (untick
    to unleash chaos)
  </label>
  <svg
    viewBox="0 0 440 190"
    role="img"
    aria-label="Router diagram: an incoming message reaches a router, which sends it to Gemini 2.5 while the primary model is healthy, or to a keyword bot fallback the moment it is not"
  >
    <defs>
      <marker
        id="r-ar"
        markerWidth="9"
        markerHeight="9"
        refX="7"
        refY="4"
        orient="auto"
      >
        <path d="M0,0 L8,4 L0,8 z" style="fill:var(--cx-teal)"></path>
      </marker>
      <marker
        id="r-arA"
        markerWidth="9"
        markerHeight="9"
        refX="7"
        refY="4"
        orient="auto"
      >
        <path d="M0,0 L8,4 L0,8 z" style="fill:var(--cx-amber)"></path>
      </marker>
      <style is:inline>
        .rbx {
          fill: var(--cx-ink3);
          stroke: var(--cx-line2);
          stroke-width: 1;
        }
        .rbxP {
          fill: var(--cx-ink3);
          stroke: var(--cx-teal);
          stroke-width: 1.6;
        }
        .rbxF {
          fill: var(--cx-ink3);
          stroke: var(--cx-amber);
          stroke-width: 1.6;
        }
        .rt {
          font-family: var(--cx-mono);
          font-size: 11px;
          font-weight: 700;
          fill: var(--cx-text);
        }
        .rs {
          font-family: var(--cx-mono);
          font-size: 9px;
          fill: var(--cx-muted);
        }
        .rl {
          stroke: var(--cx-faint);
          stroke-width: 1.6;
          fill: none;
        }
        .rlP {
          stroke: var(--cx-teal);
          stroke-width: 2;
          fill: none;
          marker-end: url(#r-ar);
        }
        .rlF {
          stroke: var(--cx-amber);
          stroke-width: 2;
          fill: none;
          marker-end: url(#r-arA);
        }
      </style>
    </defs>

    <rect class="rbx" x="10" y="70" width="90" height="50" rx="10"></rect>
    <text class="rt" x="55" y="99" text-anchor="middle">message</text>

    <rect class="rbx" x="160" y="70" width="100" height="50" rx="10"></rect>
    <text class="rt" x="210" y="92" text-anchor="middle">ROUTER</text>
    <text class="rs" x="210" y="107" text-anchor="middle">fallback-llm</text>

    <line class="rl flow-dash" x1="100" y1="95" x2="155" y2="95"></line>

    <g id="path-primary">
      <line class="rlP flow-dash" x1="260" y1="85" x2="330" y2="45"></line>
      <rect class="rbxP" x="335" y="20" width="95" height="46" rx="10"></rect>
      <text
        class="rt"
        x="382"
        y="40"
        text-anchor="middle"
        style="fill:var(--cx-teal)">Gemini 2.5</text
      >
      <text
        class="rs"
        x="382"
        y="55"
        text-anchor="middle"
        style="fill:var(--cx-teal-soft)">smart · costs money</text
      >
    </g>

    <g id="path-fallback" style="opacity:.18">
      <line class="rlF flow-dash" x1="260" y1="105" x2="330" y2="145"></line>
      <rect class="rbxF" x="335" y="124" width="95" height="46" rx="10"></rect>
      <text
        class="rt"
        x="382"
        y="144"
        text-anchor="middle"
        style="fill:var(--cx-amber)">Keyword bot</text
      >
      <text
        class="rs"
        x="382"
        y="159"
        text-anchor="middle"
        style="fill:var(--cx-amber-soft)">simple · free · alive</text
      >
    </g>
  </svg>
  <p id="router-msg" style="font-size:.92rem;font-weight:600"></p>
</div>
