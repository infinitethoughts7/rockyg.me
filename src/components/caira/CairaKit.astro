---
/**
 * Shared styles + interaction script for the Caira figures and playgrounds.
 * Import ONCE per post (the MDX does this at the top). All colors resolve
 * from the site theme via --cx-* tokens, defined for light and dark below.
 */
---

<noscript>
  <style>
    .reveal {
      opacity: 1 !important;
      transform: none !important;
    }
    .journey li {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style is:global>
  /* ==================== Caira tokens (light) ==================== */
  :root,
  html[data-theme="light"] {
    --cx-ink: var(--background);
    --cx-ink2: #f6f7f9;
    --cx-ink3: #eef1f5;
    --cx-ink4: #e8ecf1;
    --cx-line: #e2e6eb;
    --cx-line2: #d0d7de;
    --cx-text: var(--foreground);
    --cx-text2: #40474f;
    --cx-muted: #5a6570;
    --cx-faint: #7b8794;
    --cx-teal: #0e7c6f;
    --cx-teal-dim: #d9f2ee;
    --cx-teal-soft: #0b6e63;
    --cx-amber: #92600a;
    --cx-amber-dim: #f6ead1;
    --cx-amber-soft: #7c5a12;
    --cx-wa: #0e8544;
    --cx-wa-dim: #def4e6;
    --cx-wa-soft: #0e7a3d;
    --cx-wa-bg: #e7f7ec;
    --cx-wa-text: #14532d;
    --cx-red: #c22945;
    --cx-red-dim: #fbe1e6;
    --cx-red-soft: #a02440;
    --cx-violet: #6247c9;
    --cx-violet-dim: #ebe6fa;
    --cx-shadow: rgba(15, 23, 42, 0.14);
    --cx-mono: var(--font-google-sans-code), ui-monospace, monospace;
  }

  /* ==================== Caira tokens (dark, navy-tuned) ==================== */
  html[data-theme="dark"] {
    --cx-ink: var(--background);
    --cx-ink2: #1b2130;
    --cx-ink3: #2a3147;
    --cx-ink4: #171c29;
    --cx-line: #323b55;
    --cx-line2: #3e4a6e;
    --cx-text: var(--foreground);
    --cx-text2: #c3cade;
    --cx-muted: #8f9ab8;
    --cx-faint: #6a7594;
    --cx-teal: #34e4ce;
    --cx-teal-dim: #0f3b38;
    --cx-teal-soft: #8fe8db;
    --cx-amber: #f5b54a;
    --cx-amber-dim: #3a2c10;
    --cx-amber-soft: #e8cfa0;
    --cx-wa: #25d366;
    --cx-wa-dim: #123322;
    --cx-wa-soft: #7fe0a6;
    --cx-wa-bg: #132b1f;
    --cx-wa-text: #dff4e7;
    --cx-red: #ff6076;
    --cx-red-dim: #3a1620;
    --cx-red-soft: #ff9fac;
    --cx-violet: #a78bfa;
    --cx-violet-dim: #241c3d;
    --cx-shadow: rgba(0, 0, 0, 0.7);
  }

  /* ==================== helpers ==================== */
  .cx .tiny,
  .tiny.cx {
    font-size: 0.88rem;
    color: var(--cx-muted);
  }

  ol.steps {
    margin: 0.2rem 0 1.2rem;
    padding-left: 0;
    list-style: none;
    counter-reset: s;
  }
  ol.steps li {
    counter-increment: s;
    position: relative;
    padding-left: 2.4rem;
    margin: 0.85rem 0;
    color: var(--cx-text2);
  }
  ol.steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--cx-mono);
    font-size: 0.74rem;
    color: var(--cx-amber);
    border: 1px solid var(--cx-line2);
    border-radius: 6px;
    padding: 0.05rem 0.35rem;
    background: var(--cx-ink2);
  }

  .callout {
    border: 1px solid var(--cx-line2);
    border-left: 3px solid var(--cx-teal);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--cx-teal) 6%, transparent),
      transparent 70%
    );
    border-radius: 0 12px 12px 0;
    padding: 1rem 1.15rem;
    margin: 1.4rem 0;
    font-size: 0.96rem;
    color: var(--cx-text2);
  }
  .callout .lbl {
    font-family: var(--cx-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cx-teal);
    display: block;
    margin-bottom: 0.35rem;
  }

  .estimate {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--cx-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cx-amber);
    border: 1px solid color-mix(in srgb, var(--cx-amber) 35%, transparent);
    background: color-mix(in srgb, var(--cx-amber) 8%, transparent);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
    vertical-align: middle;
  }

  /* ==================== figures ==================== */
  .fig {
    margin: 1.6rem 0;
    border: 1px solid var(--cx-line);
    border-radius: 14px;
    background: var(--cx-ink2);
    padding: 1.3rem;
    overflow: hidden;
  }
  .figcap {
    font-family: var(--cx-mono);
    font-size: 0.7rem;
    color: var(--cx-faint);
    margin-top: 0.9rem;
    text-align: center;
    line-height: 1.5;
  }
  .fig svg,
  .play svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -24;
    }
  }
  .flow-dash {
    stroke-dasharray: 5 5;
    animation: dash 1.1s linear infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  .pulse {
    animation: pulse 2.4s ease-in-out infinite;
  }

  /* ==================== stat row ==================== */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    margin: 1.8rem 0;
  }
  .stat {
    background: var(--cx-ink2);
    border: 1px solid var(--cx-line);
    border-radius: 12px;
    padding: 1rem;
  }
  .stat .n {
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--cx-teal);
    line-height: 1.2;
  }
  .stat .n.amber {
    color: var(--cx-amber);
  }
  .stat .l {
    font-family: var(--cx-mono);
    font-size: 0.65rem;
    color: var(--cx-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  /* ==================== trace window ==================== */
  .trace {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 0;
    margin: 1.6rem 0 0.4rem;
    background: linear-gradient(180deg, var(--cx-ink2), var(--cx-ink));
    border: 1px solid var(--cx-line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 30px 70px -40px var(--cx-shadow);
  }
  .trace-head {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--cx-line);
    background: var(--cx-ink2);
  }
  .trace-head .lights {
    display: flex;
    gap: 0.4rem;
  }
  .trace-head .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
    opacity: 0.8;
  }
  .trace-head .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .trace-head .lights i:nth-child(2) {
    background: #febc2e;
  }
  .trace-head .lights i:nth-child(3) {
    background: #28c840;
  }
  .trace-head span {
    font-family: var(--cx-mono);
    font-size: 0.72rem;
    color: var(--cx-faint);
    margin-left: 0.3rem;
  }
  .trace-head .estimate {
    margin-left: auto;
    color: var(--cx-amber);
    font-size: 0.62rem;
  }
  .chat {
    padding: 1.3rem 1.15rem;
    border-right: 1px solid var(--cx-line);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    justify-content: center;
  }
  .bubble {
    max-width: 88%;
    padding: 0.6rem 0.8rem;
    border-radius: 13px;
    font-size: 0.92rem;
    line-height: 1.42;
    position: relative;
  }
  .bubble.in {
    align-self: flex-start;
    background: var(--cx-wa-bg);
    border: 1px solid var(--cx-wa-dim);
    color: var(--cx-wa-text);
    border-bottom-left-radius: 4px;
  }
  .bubble.in::after {
    content: "";
    position: absolute;
    left: -6px;
    bottom: 0;
    width: 12px;
    height: 12px;
    background: var(--cx-wa-bg);
    border-left: 1px solid var(--cx-wa-dim);
    border-bottom: 1px solid var(--cx-wa-dim);
    clip-path: polygon(0 100%, 100% 100%, 100% 0);
  }
  .bubble.out {
    align-self: flex-end;
    background: var(--cx-ink4);
    border: 1px solid var(--cx-line2);
    color: var(--cx-text);
    border-bottom-right-radius: 4px;
  }
  .bubble .t {
    display: block;
    font-family: var(--cx-mono);
    font-size: 0.62rem;
    color: var(--cx-faint);
    margin-top: 0.35rem;
    text-align: right;
  }
  .later {
    align-self: center;
    font-family: var(--cx-mono);
    font-size: 0.64rem;
    color: var(--cx-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0.2rem 0;
  }
  .trace-body {
    padding: 1.3rem 1.15rem;
    font-family: var(--cx-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    position: relative;
  }
  .trace-body .spine {
    position: absolute;
    left: 1.55rem;
    top: 1.7rem;
    bottom: 1.6rem;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--cx-teal),
      color-mix(in srgb, var(--cx-teal) 15%, transparent)
    );
  }
  .hop {
    position: relative;
    padding: 0.28rem 0 0.28rem 1.6rem;
    color: var(--cx-muted);
  }
  .hop::before {
    content: "";
    position: absolute;
    left: calc(1.55rem - 1.15rem);
    top: 0.62rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cx-ink);
    border: 2px solid var(--cx-teal);
    box-shadow: 0 0 0 3px var(--cx-ink);
  }
  .hop b {
    color: var(--cx-teal);
    font-weight: 500;
  }
  .hop .k {
    color: var(--cx-faint);
  }
  .hop .cost {
    color: var(--cx-amber);
  }
  .hop .ms {
    color: var(--cx-muted);
  }
  .hop.hit::before {
    border-color: var(--cx-amber);
  }
  .hop.hit b {
    color: var(--cx-amber);
  }
  #trace-runner {
    position: absolute;
    left: calc(1.55rem - 3px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cx-teal);
    box-shadow: 0 0 14px 3px color-mix(in srgb, var(--cx-teal) 80%, transparent);
    top: 1.7rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin: 1rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--cx-ink2);
    border: 1px solid var(--cx-line);
    border-radius: 12px;
    font-family: var(--cx-mono);
    font-size: 0.72rem;
    color: var(--cx-muted);
  }
  .legend b {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--cx-text2);
    font-weight: 400;
  }
  .legend b i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    display: block;
  }

  /* ==================== latency budget ==================== */
  .budget {
    margin: 1.5rem 0;
    border: 1px solid var(--cx-line);
    border-radius: 12px;
    background: var(--cx-ink2);
    padding: 1.1rem 1.2rem;
  }
  .brow {
    display: grid;
    grid-template-columns: 11rem 1fr 4.2rem;
    gap: 0.7rem;
    align-items: center;
    margin: 0.5rem 0;
    font-size: 0.84rem;
  }
  .brow .nm {
    font-family: var(--cx-mono);
    font-size: 0.74rem;
    color: var(--cx-text2);
  }
  .brow .track {
    height: 16px;
    background: var(--cx-ink4);
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--cx-line);
  }
  .brow .bar {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      var(--cx-teal),
      color-mix(in srgb, var(--cx-teal) 70%, black)
    );
    transform-origin: left;
    animation: grow 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .brow .bar.amber {
    background: linear-gradient(
      90deg,
      var(--cx-amber),
      color-mix(in srgb, var(--cx-amber) 70%, black)
    );
  }
  .brow .bar.faint {
    background: linear-gradient(90deg, var(--cx-line2), var(--cx-faint));
  }
  .brow .v {
    font-family: var(--cx-mono);
    font-size: 0.74rem;
    color: var(--cx-amber);
    text-align: right;
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .budget .tot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--cx-line2);
    font-family: var(--cx-mono);
    font-size: 0.76rem;
    color: var(--cx-muted);
    gap: 1rem;
    flex-wrap: wrap;
  }
  .budget .tot b {
    color: var(--cx-teal);
  }
  .budget .tot .wa {
    color: var(--cx-wa);
  }
  .budget .tot .wa b {
    color: var(--cx-wa);
  }

  /* ==================== scaling ladder ==================== */
  .ladder {
    margin: 1.6rem 0;
    display: grid;
    gap: 0.7rem;
  }
  .rung {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    border: 1px solid var(--cx-line);
    border-left: 3px solid var(--cx-line2);
    border-radius: 0 12px 12px 0;
    background: var(--cx-ink2);
    padding: 0.9rem 1.05rem;
  }
  .rung:nth-child(1) {
    border-left-color: var(--cx-wa);
  }
  .rung:nth-child(2) {
    border-left-color: var(--cx-teal);
  }
  .rung:nth-child(3) {
    border-left-color: var(--cx-amber);
  }
  .rung:nth-child(4) {
    border-left-color: var(--cx-red);
  }
  .rung .sz {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--cx-text);
    letter-spacing: -0.01em;
  }
  .rung .sz small {
    display: block;
    font-family: var(--cx-mono);
    font-size: 0.62rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cx-faint);
    margin-top: 0.15rem;
  }
  .rung .bd {
    font-size: 0.9rem;
    color: var(--cx-text2);
  }
  .rung .bd .breaks {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--cx-mono);
    font-size: 0.72rem;
    color: var(--cx-amber);
  }

  /* ==================== cards ==================== */
  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.4rem 0;
  }
  .card {
    border: 1px solid var(--cx-line);
    border-radius: 12px;
    background: var(--cx-ink2);
    padding: 1rem 1.1rem;
  }
  .card h4 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .card p {
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
    color: var(--cx-text2);
  }
  .card p:last-child {
    margin: 0;
  }
  .card .tiny {
    font-size: 0.82rem;
    color: var(--cx-muted);
  }

  /* ==================== nerd box ==================== */
  .nerdbox {
    margin: 1.4rem 0;
    border: 1px solid var(--cx-line2);
    border-radius: 12px;
    background: var(--cx-ink2);
    overflow: hidden;
  }
  .nerdbox summary {
    cursor: pointer;
    list-style: none;
    padding: 0.75rem 1rem;
    font-family: var(--cx-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cx-amber);
  }
  .nerdbox summary::-webkit-details-marker {
    display: none;
  }
  .nerdbox[open] summary {
    border-bottom: 1px solid var(--cx-line);
  }
  .nerdbox .nb-body {
    padding: 0.9rem 1.1rem;
    font-size: 0.92rem;
    color: var(--cx-text2);
  }
  .nerdbox .nb-body p {
    margin: 0 0 0.7rem;
  }
  .nerdbox .nb-body p:last-child,
  .nerdbox .nb-body ol:last-child {
    margin-bottom: 0;
  }

  /* ==================== playground chrome ==================== */
  .play {
    border: 1px solid var(--cx-line);
    border-radius: 14px;
    background: var(--cx-ink2);
    padding: 1.1rem 1.2rem;
    margin: 1.4rem 0;
  }
  .play-label {
    font-family: var(--cx-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cx-amber);
    margin-bottom: 0.8rem;
  }
  .btn {
    appearance: none;
    border: 1px solid var(--cx-line2);
    border-radius: 9px;
    background: var(--cx-ink3);
    color: var(--cx-text);
    font-family: var(--cx-mono);
    font-size: 0.78rem;
    padding: 0.55rem 0.95rem;
    cursor: pointer;
    transition: all 0.18s;
  }
  .btn:hover {
    border-color: var(--cx-teal);
    color: var(--cx-teal);
  }
  .btn.primary {
    background: var(--cx-teal-dim);
    border-color: color-mix(in srgb, var(--cx-teal) 40%, transparent);
    color: var(--cx-teal);
  }
  .play input[type="text"],
  .play textarea {
    width: 100%;
    box-sizing: border-box;
    background: var(--cx-ink4);
    border: 1px solid var(--cx-line2);
    border-radius: 9px;
    color: var(--cx-text);
    font-size: 0.92rem;
    padding: 0.6rem 0.8rem;
  }
  .play input[type="text"]:focus,
  .play textarea:focus {
    outline: none;
    border-color: var(--cx-teal);
  }
  .play input[type="range"] {
    width: 100%;
    accent-color: var(--cx-amber);
  }
  .playlog {
    font-family: var(--cx-mono);
    font-size: 0.74rem;
    line-height: 1.7;
    background: var(--cx-ink4);
    border: 1px solid var(--cx-line);
    border-radius: 9px;
    padding: 0.8rem 0.9rem;
    min-height: 6.5rem;
    margin-top: 0.8rem;
    color: var(--cx-muted);
  }
  .playlog div {
    opacity: 0;
    animation: pop 0.4s forwards;
  }
  @keyframes pop {
    to {
      opacity: 1;
    }
  }
  .playlog .amber {
    color: var(--cx-amber);
  }
  .playlog .teal {
    color: var(--cx-teal);
  }
  .playlog b {
    color: var(--cx-text2);
  }
  .chunk {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--cx-line2);
    border-radius: 9px;
    margin-top: 0.55rem;
    font-size: 0.88rem;
    color: var(--cx-text2);
    transition: all 0.3s;
    background: var(--cx-ink3);
  }
  .chunk.win {
    border-color: var(--cx-teal);
    background: var(--cx-teal-dim);
    transform: scale(1.02);
  }
  .chunk .sc {
    float: right;
    font-family: var(--cx-mono);
    font-size: 0.7rem;
    color: var(--cx-faint);
  }
  .chunk.win .sc {
    color: var(--cx-teal);
  }
  .badge {
    display: inline-block;
    min-width: 3.2rem;
    text-align: center;
    font-family: var(--cx-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    margin-right: 0.55rem;
  }
  .badge.wait {
    background: var(--cx-ink4);
    color: var(--cx-faint);
  }
  .badge.pass {
    background: var(--cx-wa-dim);
    color: var(--cx-wa);
  }
  .badge.fail {
    background: var(--cx-red-dim);
    color: var(--cx-red);
  }
  .eval-row {
    padding: 0.42rem 0;
    font-size: 0.9rem;
    border-bottom: 1px dashed var(--cx-line);
    color: var(--cx-text2);
  }
  .eval-row:last-child {
    border-bottom: none;
  }
  .scorebar {
    height: 12px;
    border-radius: 999px;
    background: var(--cx-ink4);
    overflow: hidden;
    margin-top: 0.8rem;
  }
  .scorebar > div {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--cx-teal), var(--cx-wa));
    width: 0;
    transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bignum {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .mem-smart {
    color: var(--cx-teal);
  }

  /* ==================== reveal on scroll ==================== */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* ==================== responsive ==================== */
  @media (max-width: 820px) {
    .grid2 {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .trace {
      grid-template-columns: 1fr;
    }
    .chat {
      border-right: none;
      border-bottom: 1px solid var(--cx-line);
    }
    .brow {
      grid-template-columns: 8rem 1fr 3.6rem;
    }
    .rung {
      grid-template-columns: 1fr;
    }
  }

  /* ==================== reduced motion ==================== */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #trace-runner {
      display: none;
    }
    .flow-dash,
    .pulse,
    .brow .bar {
      animation: none;
    }
    .playlog div {
      opacity: 1;
      animation: none;
    }
    .chunk.win {
      transform: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const $ = id => document.getElementById(id);
      /* only act on pages that carry the Caira figures */
      if (!document.querySelector(".trace") && !document.querySelector(".play"))
        return;
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      /* reveal on scroll */
      const revealEls = document.querySelectorAll(".reveal:not(.in)");
      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          entries => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        revealEls.forEach(el => io.observe(el));
      } else {
        revealEls.forEach(el => el.classList.add("in"));
      }

      /* hero runner */
      const runner = $("trace-runner");
      const hops = Array.from(document.querySelectorAll(".trace-body .hop"));
      if (!reduce && runner && hops.length && !runner.dataset.on) {
        runner.dataset.on = "1";
        let i = 0;
        runner.style.transition = "top .5s cubic-bezier(.4,0,.2,1)";
        const step = () => {
          if (!document.body.contains(runner)) return;
          runner.style.top = hops[i].offsetTop + 8 + "px";
          i = (i + 1) % hops.length;
          setTimeout(step, i === 0 ? 1400 : 700);
        };
        setTimeout(step, 900);
      }

      /* grounding: librarian */
      const ragRun = $("rag-run");
      if (ragRun && !ragRun.dataset.on) {
        ragRun.dataset.on = "1";
        ragRun.addEventListener("click", () => {
          const q = ($("rag-q").value || "").toLowerCase();
          const chunks = Array.from(document.querySelectorAll(".rag-chunk"));
          let best = null;
          let bestScore = 0;
          chunks.forEach(c => {
            const score = (c.dataset.k || "")
              .split(" ")
              .reduce((n, k) => n + (k && q.includes(k) ? 1 : 0), 0);
            c.classList.remove("win");
            c.querySelector(".sc").textContent = score ? "+" + score : "0";
            if (score > bestScore) {
              best = c;
              bestScore = score;
            }
          });
          $("rag-out").textContent = best
            ? "Only the winning facts travel to the AI. The rest stay on the shelf."
            : 'No fact matches, so Caira answers: "Let me check with the clinic." Guessing is not on the menu.';
          if (best) best.classList.add("win");
        });
      }

      /* guardrails: the bouncer */
      const guardRun = $("guard-run");
      if (guardRun && !guardRun.dataset.on) {
        guardRun.dataset.on = "1";
        const TRICKS = [
          "ignore",
          "instruction",
          "pretend",
          "free",
          "discount",
          "system prompt",
          "jailbreak",
          "your rules",
          "forget",
        ];
        guardRun.addEventListener("click", () => {
          const v = ($("guard-in").value || "").toLowerCase();
          const bad = TRICKS.some(t => v.includes(t));
          $("guard-shield").textContent = bad ? "🚫" : "🛡️";
          $("guard-out").textContent = bad
            ? "Blocked. Nice try. The bouncer has heard that one before."
            : "Looks like a normal guest. In they go.";
        });
      }

      /* memory toggle */
      const memToggle = $("mem-toggle");
      if (memToggle && !memToggle.dataset.on) {
        memToggle.dataset.on = "1";
        const line = $("mem-reply");
        const render = () => {
          line.textContent = memToggle.checked
            ? "Booking you with Dr. Rao again, evening slot as usual. Anything else?"
            : "Which doctor would you like to see?";
          line.classList.toggle("mem-smart", memToggle.checked);
        };
        memToggle.addEventListener("change", render);
        render();
      }

      /* cache: ask twice */
      const cacheAsk = $("cache-ask");
      if (cacheAsk && !cacheAsk.dataset.on) {
        cacheAsk.dataset.on = "1";
        let asked = false;
        cacheAsk.addEventListener("click", () => {
          const row = document.createElement("div");
          if (!asked) {
            row.innerHTML =
              '<b>Patient 1:</b> "what are your timings?" → model thinks ~640 ms → <span class="amber">$0.0005</span> → answer saved';
            asked = true;
            cacheAsk.textContent = "Another patient asks the same thing";
          } else {
            row.innerHTML =
              '<b>Patient 2:</b> "timings?" → cache HIT → <span class="teal">0 ms · $0.00</span> → same correct answer, free';
          }
          $("cache-log").appendChild(row);
        });
      }

      /* cache: bill sliders */
      const billMsgs = $("bill-msgs");
      if (billMsgs && !billMsgs.dataset.on) {
        billMsgs.dataset.on = "1";
        const calc = () => {
          const msgs = Number(billMsgs.value);
          const pct = Number($("bill-cache").value);
          $("bill-msgs-v").textContent = String(msgs);
          $("bill-cache-v").textContent = pct + "%";
          const monthNo = msgs * 30 * 0.0005;
          const monthYes = monthNo * (1 - pct / 100);
          $("bill-no").textContent = "$" + monthNo.toFixed(2);
          $("bill-yes").textContent = "$" + monthYes.toFixed(2);
          $("bill-save").textContent =
            "Same answers, " +
            pct +
            "% smaller AI bill. Modeled at ~$0.0005 per grounded answer.";
        };
        billMsgs.addEventListener("input", calc);
        $("bill-cache").addEventListener("input", calc);
        calc();
      }

      /* fallback router */
      const geminiUp = $("gemini-up");
      if (geminiUp && !geminiUp.dataset.on) {
        geminiUp.dataset.on = "1";
        const draw = () => {
          const up = geminiUp.checked;
          $("path-primary").style.opacity = up ? "1" : ".18";
          $("path-fallback").style.opacity = up ? ".18" : "1";
          $("router-msg").textContent = up
            ? "Gemini healthy: smart answers at a tiny cost per question."
            : "Gemini is down. The keyword bot catches the conversation. Simpler answers, zero dollars, nobody left on read.";
        };
        geminiUp.addEventListener("change", draw);
        draw();
      }

      /* queue simulation */
      const queueBtns = document.querySelectorAll("[data-queue-mode]");
      if (queueBtns.length && !queueBtns[0].dataset.on) {
        const LOGS = {
          phone: [
            ["0 ms", "Meta delivers the message and waits on the line"],
            ["25,000 ms", "the model is having a very bad day"],
            ["timeout", "Meta gives up and RESENDS the same message"],
            ["result", "duplicate replies, spammed patient, angry clinic"],
          ],
          queue: [
            ["0 ms", "Meta delivers the message"],
            ["50 ms", 'Caira: "got it." Message dropped in the letterbox'],
            ["later", "worker picks it up, retries safely if needed"],
            ["result", "one reply, delivered once. Boring. Perfect."],
          ],
        };
        queueBtns.forEach(b => {
          b.dataset.on = "1";
          b.addEventListener("click", () => {
            const log = $("queue-log");
            log.innerHTML = "";
            LOGS[b.dataset.queueMode].forEach(([t, msg], i) => {
              const d = document.createElement("div");
              d.style.animationDelay = i * 0.45 + "s";
              d.innerHTML = "<b>" + t + "</b> · " + msg;
              log.appendChild(d);
            });
          });
        });
      }

      /* evals exam */
      const evalBtns = document.querySelectorAll("[data-eval-version]");
      if (evalBtns.length && !evalBtns[0].dataset.on) {
        let last = null;
        evalBtns.forEach(b => {
          b.dataset.on = "1";
          b.addEventListener("click", () => {
            const v = b.dataset.evalVersion;
            const rows = Array.from(
              document.querySelectorAll("#eval-rows .badge")
            );
            let pass = 0;
            let regression = false;
            rows.forEach((r, i) => {
              const res = r.dataset[v];
              setTimeout(
                () => {
                  r.textContent = res.toUpperCase();
                  r.className = "badge " + res;
                },
                reduce ? 0 : i * 250
              );
              if (res === "pass") pass += 1;
              if (last && r.dataset[last] === "pass" && res === "fail")
                regression = true;
            });
            setTimeout(
              () => {
                $("eval-fill").style.width = (pass / rows.length) * 100 + "%";
                $("eval-score").textContent = pass + "/" + rows.length;
                $("eval-moral").textContent = regression
                  ? "REGRESSION ALARM: a case that used to pass now fails. This deploy is blocked before any patient sees it."
                  : "Score recorded. Change the prompt, run the exam again, let the number tell the truth.";
              },
              reduce ? 0 : rows.length * 250 + 200
            );
            last = v;
          });
        });
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
    if (!window.__cairaKitNav) {
      window.__cairaKitNav = true;
      document.addEventListener("astro:after-swap", init);
    }
  })();
</script>
