---
import NerdBox from "@/components/caira/NerdBox.astro";
---

<div class="reveal">
  <div class="fig">
    <svg
      viewBox="0 0 720 470"
      role="img"
      aria-label="System context diagram: patients, staff and doctors on the left; the system in the centre; seven external vendor services on the right"
    >
      <defs>
        <marker
          id="c-ar"
          markerWidth="9"
          markerHeight="9"
          refX="7"
          refY="4"
          orient="auto"
        >
          <path d="M0,0 L8,4 L0,8 z" style="fill:var(--cx-teal)"></path>
        </marker>
        <marker
          id="c-arA"
          markerWidth="9"
          markerHeight="9"
          refX="7"
          refY="4"
          orient="auto"
        >
          <path d="M0,0 L8,4 L0,8 z" style="fill:var(--cx-amber)"></path>
        </marker>
        <marker
          id="c-arW"
          markerWidth="9"
          markerHeight="9"
          refX="7"
          refY="4"
          orient="auto"
        >
          <path d="M0,0 L8,4 L0,8 z" style="fill:var(--cx-wa)"></path>
        </marker>
        <style is:inline>
          .cbx {
            fill: var(--cx-ink3);
            stroke: var(--cx-line2);
            stroke-width: 1;
          }
          .cactor {
            fill: var(--cx-ink2);
            stroke: var(--cx-line2);
            stroke-width: 1;
          }
          .csys {
            fill: var(--cx-teal-dim);
            stroke: var(--cx-teal);
            stroke-width: 1.6;
          }
          .ct {
            font-family: var(--cx-mono);
            font-size: 10.5px;
            fill: var(--cx-text);
          }
          .cs {
            font-family: var(--cx-mono);
            font-size: 8.5px;
            fill: var(--cx-muted);
          }
          .ch {
            font-family: var(--cx-mono);
            font-size: 15px;
            font-weight: 600;
            fill: var(--cx-teal);
            text-anchor: middle;
          }
          .chs {
            font-family: var(--cx-mono);
            font-size: 8.5px;
            fill: var(--cx-muted);
            text-anchor: middle;
          }
          .cl {
            stroke: var(--cx-teal);
            stroke-width: 1.4;
            fill: none;
            marker-end: url(#c-ar);
          }
          .clw {
            stroke: var(--cx-wa);
            stroke-width: 1.6;
            fill: none;
            marker-end: url(#c-arW);
          }
          .cla {
            stroke: var(--cx-amber);
            stroke-width: 1.3;
            fill: none;
            marker-end: url(#c-arA);
          }
          .cgrp {
            font-family: var(--cx-mono);
            font-size: 8px;
            fill: var(--cx-faint);
            letter-spacing: 0.14em;
          }
          .cport {
            font-family: var(--cx-mono);
            font-size: 7.5px;
            fill: var(--cx-amber);
          }
        </style>
      </defs>

      <!-- group labels -->
      <text class="cgrp" x="16" y="14">HUMANS</text>
      <text class="cgrp" x="272" y="14">THE SYSTEM</text>
      <text class="cgrp" x="536" y="14">RENTED SERVICES</text>

      <!-- actors -->
      <rect class="cactor" x="16" y="28" width="148" height="54" rx="9"></rect>
      <text class="ct" x="30" y="49">Patient</text>
      <text class="cs" x="30" y="65">WhatsApp only · te/hi/en</text>

      <rect class="cactor" x="16" y="186" width="148" height="54" rx="9"></rect>
      <text class="ct" x="30" y="207">Clinic staff</text>
      <text class="cs" x="30" y="223">web dashboard · Supabase auth</text>

      <rect class="cactor" x="16" y="266" width="148" height="54" rx="9"></rect>
      <text class="ct" x="30" y="287">Doctor</text>
      <text class="cs" x="30" y="303">own day · availability · wellness</text>

      <rect
        class="cactor"
        x="16"
        y="382"
        width="148"
        height="50"
        rx="9"
        stroke-dasharray="3 3"></rect>
      <text class="ct" x="30" y="402">Vercel Cron</text>
      <text class="cs" x="30" y="418">wakes the queue drain</text>

      <!-- the system -->
      <rect class="csys" x="238" y="120" width="196" height="150" rx="14"
      ></rect>
      <text class="ch" x="336" y="176">Caira</text>
      <text class="chs" x="336" y="196">multi-tenant · stateless</text>
      <text class="chs" x="336" y="210">Next.js on Vercel</text>
      <text class="chs" x="336" y="232" style="fill:var(--cx-amber)"
        >21 modules · 24 ports</text
      >

      <!-- externals -->
      <rect class="cbx" x="512" y="28" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="46">Meta WhatsApp Cloud</text>
      <text class="cs" x="524" y="60">Graph v21 · messages, Flows</text>

      <rect class="cbx" x="512" y="80" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="98">Google Gemini 2.5 Flash</text>
      <text class="cs" x="524" y="112">intent + grounded answers</text>

      <rect class="cbx" x="512" y="132" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="150">Sarvam</text>
      <text class="cs" x="524" y="164">Indic translation</text>

      <rect class="cbx" x="512" y="184" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="202">Supabase Postgres</text>
      <text class="cs" x="524" y="216">22 tables · RLS · auth</text>

      <rect class="cbx" x="512" y="236" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="254">Upstash Redis</text>
      <text class="cs" x="524" y="268">shared answer cache</text>

      <rect class="cbx" x="512" y="288" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="306">Razorpay</text>
      <text class="cs" x="524" y="320">upfront-fee payment links</text>

      <rect class="cbx" x="512" y="340" width="192" height="42" rx="8"></rect>
      <text class="ct" x="524" y="358">Langfuse</text>
      <text class="cs" x="524" y="372">per-call cost + latency traces</text>

      <!-- patient path via Meta (green) -->
      <path class="clw" d="M164,48 C210,48 214,44 508,44"></path>
      <text class="cport" x="238" y="40">sends / receives</text>
      <path class="clw flow-dash" d="M604,70 C604,100 470,96 436,150"></path>

      <!-- staff + doctor -->
      <path class="cl" d="M164,208 C200,208 206,200 236,196"></path>
      <path class="cl" d="M164,288 C200,288 210,256 236,242"></path>
      <path class="cla" d="M164,404 C210,404 300,330 336,272"></path>

      <!-- system to externals -->
      <path class="cl" d="M434,168 C470,168 476,104 508,101"></path>
      <text class="cport" x="446" y="126">LlmProvider</text>
      <path class="cl" d="M434,186 C470,186 480,154 508,153"></path>
      <text class="cport" x="446" y="176">TranslationProvider</text>
      <path class="cl" d="M434,204 C470,204 480,205 508,205"></path>
      <text class="cport" x="446" y="200">~15 repositories</text>
      <path class="cl" d="M434,222 C470,222 480,256 508,257"></path>
      <text class="cport" x="446" y="238">Cache&lt;V&gt;</text>
      <path class="cl" d="M434,240 C470,240 478,308 508,309"></path>
      <text class="cport" x="446" y="272">PaymentProvider</text>
      <path class="cl" d="M434,256 C468,256 476,360 508,361"></path>
      <text class="cport" x="446" y="300">LlmMetricsSink</text>

      <!-- razorpay webhook back -->
      <path class="cla" d="M512,320 C470,330 440,300 436,264"></path>
    </svg>
    <div class="figcap">
      Green: the WhatsApp path a patient experiences. Teal: calls we make
      outward, each labelled with its port. Amber dashed: things that call us
      back in.
    </div>
  </div>

  <NerdBox title="why this map is load-bearing">
    <p>
      A patient has no direct edge to the system: every inbound byte arrives via
      Meta, signed, which is what makes the tenant router trustworthy. And every
      outward edge is labelled with a port name (LlmProvider,
      TranslationProvider, Cache, PaymentProvider, LlmMetricsSink, ~15
      repositories), not a vendor name. The vendor is resolved in one file, the
      composition root.
    </p>
  </NerdBox>
</div>
