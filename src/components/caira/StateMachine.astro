---

---

<div class="reveal fig">
  <svg
    viewBox="0 0 720 400"
    role="img"
    aria-label="Conversation state machine with idle at the centre and four branch chains: booking, reschedule, review funnel and wellness check-in"
  >
    <defs>
      <marker
        id="sm-ar"
        markerWidth="8"
        markerHeight="8"
        refX="6.5"
        refY="3.5"
        orient="auto"
      >
        <path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--cx-teal)"></path>
      </marker>
      <marker
        id="sm-arA"
        markerWidth="8"
        markerHeight="8"
        refX="6.5"
        refY="3.5"
        orient="auto"
      >
        <path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--cx-amber)"></path>
      </marker>
      <style is:inline>
        .smst {
          fill: var(--cx-ink3);
          stroke: var(--cx-line2);
          stroke-width: 1;
        }
        .smst.smidle {
          fill: var(--cx-teal-dim);
          stroke: var(--cx-teal);
          stroke-width: 1.5;
        }
        .smst.smterm {
          fill: var(--cx-ink2);
          stroke: var(--cx-wa);
          stroke-width: 1.2;
        }
        .smsn {
          font-family: var(--cx-mono);
          font-size: 8.5px;
          fill: var(--cx-text);
          text-anchor: middle;
        }
        .smse {
          stroke: var(--cx-teal);
          stroke-width: 1.2;
          fill: none;
          marker-end: url(#sm-ar);
        }
        .smsea {
          stroke: var(--cx-amber);
          stroke-width: 1.1;
          fill: none;
          marker-end: url(#sm-arA);
          stroke-dasharray: 3 3;
        }
        .smsl {
          font-family: var(--cx-mono);
          font-size: 7px;
          fill: var(--cx-faint);
        }
        .smsg {
          font-family: var(--cx-mono);
          font-size: 7.5px;
          fill: var(--cx-faint);
          letter-spacing: 0.12em;
        }
      </style>
    </defs>

    <!-- idle hub -->
    <rect
      class="smst smidle pulse"
      x="292"
      y="176"
      width="136"
      height="40"
      rx="10"></rect>
    <text class="smsn" x="360" y="194" style="fill:var(--cx-teal)">idle</text>
    <text
      class="smsn"
      x="360"
      y="207"
      style="font-size:7px;fill:var(--cx-muted)"
      >every turn can return here</text
    >

    <!-- booking chain (top) -->
    <text class="smsg" x="14" y="18">BOOKING · intent book_appointment</text>
    <rect class="smst" x="14" y="30" width="98" height="26" rx="7"></rect>
    <text class="smsn" x="63" y="47">booking_location</text>
    <rect class="smst" x="124" y="30" width="104" height="26" rx="7"></rect>
    <text class="smsn" x="176" y="47">booking_department</text>
    <rect class="smst" x="240" y="30" width="88" height="26" rx="7"></rect>
    <text class="smsn" x="284" y="47">booking_doctor</text>
    <rect class="smst" x="340" y="30" width="80" height="26" rx="7"></rect>
    <text class="smsn" x="380" y="47">booking_slot</text>
    <rect class="smst" x="432" y="30" width="80" height="26" rx="7"></rect>
    <text class="smsn" x="472" y="47">booking_name</text>
    <rect class="smst" x="524" y="30" width="104" height="26" rx="7"></rect>
    <text class="smsn" x="576" y="47">awaiting_confirm</text>
    <rect class="smst smterm" x="640" y="30" width="66" height="26" rx="7"
    ></rect>
    <text class="smsn" x="673" y="47" style="fill:var(--cx-wa-soft)"
      >booked</text
    >

    <path class="smse" d="M112,43 L122,43"></path>
    <path class="smse" d="M228,43 L238,43"></path>
    <path class="smse" d="M328,43 L338,43"></path>
    <path class="smse" d="M420,43 L430,43"></path>
    <path class="smse" d="M512,43 L522,43"></path>
    <path class="smse" d="M628,43 L638,43"></path>

    <!-- flow variant -->
    <rect
      class="smst"
      x="240"
      y="82"
      width="188"
      height="26"
      rx="7"
      stroke-dasharray="3 3"></rect>
    <text class="smsn" x="334" y="99"
      >booking_flow: native WhatsApp form replaces 1-5</text
    >
    <path class="smsea" d="M360,174 L360,110"></path>
    <path class="smsea" d="M428,88 C500,88 560,66 574,58"></path>

    <!-- reschedule chain (left) -->
    <text class="smsg" x="14" y="146">RESCHEDULE</text>
    <rect class="smst" x="14" y="156" width="110" height="26" rx="7"></rect>
    <text class="smsn" x="69" y="173">reschedule_select</text>
    <rect class="smst" x="14" y="190" width="110" height="26" rx="7"></rect>
    <text class="smsn" x="69" y="207">reschedule_slot</text>
    <rect
      class="smst"
      x="14"
      y="224"
      width="110"
      height="26"
      rx="7"
      stroke-dasharray="3 3"></rect>
    <text class="smsn" x="69" y="241">reschedule_flow</text>
    <path class="smse" d="M69,182 L69,188"></path>
    <path class="smse" d="M69,216 L69,222"></path>
    <path class="smse" d="M124,196 L290,196"></path>
    <path class="smsea" d="M292,186 C220,150 140,150 122,160"></path>

    <!-- review chain (bottom) -->
    <text class="smsg" x="200" y="278"
      >REVIEW FUNNEL · triggered by a queue job, not by the patient</text
    >
    <rect class="smst" x="200" y="288" width="88" height="26" rx="7"></rect>
    <text class="smsn" x="244" y="305">review_open</text>
    <rect class="smst" x="300" y="288" width="94" height="26" rx="7"></rect>
    <text class="smsn" x="347" y="305">review_rating</text>
    <rect class="smst" x="406" y="288" width="104" height="26" rx="7"></rect>
    <text class="smsn" x="458" y="305">review_dimension</text>
    <rect class="smst" x="522" y="288" width="98" height="26" rx="7"></rect>
    <text class="smsn" x="571" y="305">review_comment</text>
    <path class="smse" d="M288,301 L298,301"></path>
    <path class="smse" d="M394,301 L404,301"></path>
    <path class="smse" d="M510,301 L520,301"></path>
    <path class="smsea" d="M394,290 C420,266 540,262 571,286"></path>
    <text class="smsl" x="424" y="272"
      >rating ≥ 4 → skip straight to Google link</text
    >
    <path class="smse" d="M340,216 L280,286"></path>

    <!-- wellness -->
    <rect class="smst" x="522" y="176" width="104" height="40" rx="8"></rect>
    <text class="smsn" x="574" y="193">wellness_reply</text>
    <text
      class="smsn"
      x="574"
      y="206"
      style="font-size:7px;fill:var(--cx-muted)">good / better / bad</text
    >
    <path class="smse" d="M428,196 L520,196"></path>
    <path class="smsea" d="M574,216 C574,250 460,250 420,206"></path>

    <!-- returns -->
    <path class="smsea" d="M673,56 C700,120 460,150 428,180"></path>
    <text class="smsl" x="560" y="140">every terminal state → idle</text>

    <text class="smsg" x="14" y="342"
      >STORED AS: conversations.state (text) + conversations.state_data (jsonb)</text
    >
    <text class="smsg" x="14" y="358" style="fill:var(--cx-amber)"
      >NO IN-MEMORY SESSION · A REDEPLOY MID-BOOKING LOSES NOTHING</text
    >
    <text class="smsg" x="14" y="374"
      >17 STATES · UNIQUE (clinic_id, patient_id): ONE LIVE CONVERSATION PER
      PATIENT PER CLINIC</text
    >
  </svg>
  <div class="figcap">
    Solid = the forward path, amber (dashed) = shortcuts, escapes and returns to <code
      >idle</code
    >. The Flow variant collapses a five-state chain into one native form. The
    teal box is the one you are standing in right now.
  </div>
</div>
