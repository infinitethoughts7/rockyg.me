---
import NerdBox from "@/components/caira/NerdBox.astro";
---

<div class="reveal">
  <div class="fig">
    <svg
      viewBox="0 0 720 500"
      role="img"
      aria-label="Container diagram: edge routes, domain layer, and data layer"
    >
      <defs>
        <marker
          id="k-ar"
          markerWidth="8"
          markerHeight="8"
          refX="6.5"
          refY="3.5"
          orient="auto"
        >
          <path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--cx-teal)"></path>
        </marker>
        <marker
          id="k-arA"
          markerWidth="8"
          markerHeight="8"
          refX="6.5"
          refY="3.5"
          orient="auto"
        >
          <path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--cx-amber)"></path>
        </marker>
        <style is:inline>
          .lane {
            fill: none;
            stroke: var(--cx-line);
            stroke-width: 1;
            stroke-dasharray: 4 4;
          }
          .lanet {
            font-family: var(--cx-mono);
            font-size: 8px;
            fill: var(--cx-faint);
            letter-spacing: 0.16em;
          }
          .kbx {
            fill: var(--cx-ink3);
            stroke: var(--cx-line2);
            stroke-width: 1;
          }
          .kedge {
            fill: var(--cx-ink2);
            stroke: var(--cx-amber);
            stroke-width: 1.2;
          }
          .kdom {
            fill: var(--cx-teal-dim);
            stroke: var(--cx-teal);
            stroke-width: 1.4;
          }
          .kdb {
            fill: var(--cx-ink3);
            stroke: var(--cx-muted);
            stroke-width: 1.2;
          }
          .kt {
            font-family: var(--cx-mono);
            font-size: 10px;
            fill: var(--cx-text);
          }
          .ks {
            font-family: var(--cx-mono);
            font-size: 8px;
            fill: var(--cx-muted);
          }
          .kl {
            stroke: var(--cx-teal);
            stroke-width: 1.3;
            fill: none;
            marker-end: url(#k-ar);
          }
          .kla {
            stroke: var(--cx-amber);
            stroke-width: 1.3;
            fill: none;
            marker-end: url(#k-arA);
          }
          .klab {
            font-family: var(--cx-mono);
            font-size: 7.5px;
            fill: var(--cx-faint);
          }
        </style>
      </defs>

      <!-- lanes -->
      <line class="lane" x1="0" y1="96" x2="720" y2="96"></line>
      <line class="lane" x1="0" y1="196" x2="720" y2="196"></line>
      <line class="lane" x1="0" y1="392" x2="720" y2="392"></line>
      <text class="lanet" x="6" y="16">INBOUND</text>
      <text class="lanet" x="6" y="112"
        >EDGE · thin HTTP shells</text
      >
      <text class="lanet" x="6" y="212"
        >DOMAIN · pure, port-backed, zero-secret</text
      >
      <text class="lanet" x="6" y="408">STATE</text>

      <!-- inbound -->
      <rect class="kbx" x="16" y="26" width="140" height="48" rx="8"></rect>
      <text class="kt" x="28" y="46">Meta webhook</text>
      <text class="ks" x="28" y="61">patient message</text>

      <rect class="kbx" x="176" y="26" width="140" height="48" rx="8"></rect>
      <text class="kt" x="188" y="46">Meta Flow</text>
      <text class="ks" x="188" y="61">RSA data_exchange</text>

      <rect class="kbx" x="336" y="26" width="128" height="48" rx="8"></rect>
      <text class="kt" x="348" y="46">Cron timer</text>
      <text class="ks" x="348" y="61">Bearer CRON_SECRET</text>

      <rect class="kbx" x="484" y="26" width="106" height="48" rx="8"></rect>
      <text class="kt" x="496" y="46">Payments</text>
      <text class="ks" x="496" y="61">paid event</text>

      <rect class="kbx" x="610" y="26" width="94" height="48" rx="8"></rect>
      <text class="kt" x="620" y="46">Browser</text>
      <text class="ks" x="620" y="61">staff / doctor</text>

      <!-- edge routes -->
      <rect class="kedge" x="16" y="122" width="140" height="52" rx="8"></rect>
      <text class="kt" x="26" y="141">/webhooks/whatsapp</text>
      <text class="ks" x="26" y="156">HMAC · 88 lines</text>

      <rect class="kedge" x="176" y="122" width="140" height="52" rx="8"></rect>
      <text class="kt" x="186" y="141">…/whatsapp/flow</text>
      <text class="ks" x="186" y="156">decrypt · 31 lines</text>

      <rect class="kedge" x="336" y="122" width="128" height="52" rx="8"></rect>
      <text class="kt" x="346" y="141">/cron/reminders</text>
      <text class="ks" x="346" y="156">401 without secret</text>

      <rect class="kedge" x="484" y="122" width="106" height="52" rx="8"></rect>
      <text class="kt" x="493" y="141">/webhooks/</text>
      <text class="kt" x="493" y="154">razorpay</text>

      <rect class="kedge" x="610" y="122" width="94" height="52" rx="8"></rect>
      <text class="kt" x="619" y="141">RSC pages</text>
      <text class="ks" x="619" y="156">+ /api/doctor/*</text>

      <!-- domain -->
      <rect class="kdom" x="16" y="222" width="300" height="60" rx="10"></rect>
      <text class="kt" x="28" y="243" style="fill:var(--cx-teal)"
        >bot-brain · the loop</text
      >
      <text class="ks" x="28" y="258"
        >verify → sort intent → branch → reply</text
      >
      <text class="ks" x="28" y="272">one function, no vendor import</text>

      <rect class="kdom" x="336" y="222" width="180" height="60" rx="10"></rect>
      <text class="kt" x="348" y="243" style="fill:var(--cx-teal)"
        >drainDueJobs</text
      >
      <text class="ks" x="348" y="258">claim 100 · SKIP LOCKED</text>
      <text class="ks" x="348" y="272">5 job types · dead-letter at 5</text>

      <rect class="kdom" x="536" y="222" width="168" height="60" rx="10"></rect>
      <text class="kt" x="548" y="243" style="fill:var(--cx-teal)"
        >FlowExchangeService</text
      >
      <text class="ks" x="548" y="258">5 screens · 7-day horizon</text>
      <text class="ks" x="548" y="272">max 20 slot options</text>

      <rect class="kbx" x="16" y="298" width="140" height="76" rx="9"></rect>
      <text class="kt" x="26" y="317">language</text>
      <text class="ks" x="26" y="332">prompt · schema</text>
      <text class="ks" x="26" y="345">sanitize · cache</text>
      <text class="ks" x="26" y="361" style="fill:var(--cx-amber)"
        >retrieval top-K</text
      >

      <rect class="kbx" x="168" y="298" width="140" height="76" rx="9"></rect>
      <text class="kt" x="178" y="317">availability</text>
      <text class="ks" x="178" y="332">slot-math (pure)</text>
      <text class="ks" x="178" y="345">holds · 5 min TTL</text>
      <text class="ks" x="178" y="361">schedule + overrides</text>

      <rect class="kbx" x="320" y="298" width="130" height="76" rx="9"></rect>
      <text class="kt" x="330" y="317">booking</text>
      <text class="ks" x="330" y="332">idempotency key</text>
      <text class="ks" x="330" y="345">status machine</text>
      <text class="ks" x="330" y="361">23505 backstop</text>

      <rect class="kbx" x="462" y="298" width="118" height="76" rx="9"></rect>
      <text class="kt" x="472" y="317">reviews</text>
      <text class="kt" x="472" y="333">wellness</text>
      <text class="kt" x="472" y="349">waitlist</text>
      <text class="ks" x="472" y="364">post-visit funnels</text>

      <rect class="kbx" x="592" y="298" width="112" height="76" rx="9"></rect>
      <text class="kt" x="602" y="317">dashboard</text>
      <text class="kt" x="602" y="333">doctor</text>
      <text class="ks" x="602" y="349">read models</text>
      <text class="ks" x="602" y="364">+ mutations</text>

      <!-- state -->
      <rect class="kdb" x="16" y="418" width="330" height="52" rx="9"></rect>
      <text class="kt" x="28" y="438"
        >Postgres: the single source of truth</text
      >
      <text class="ks" x="28" y="454"
        >every tenant row carries its clinic id · RLS as the backstop</text
      >

      <rect class="kdb" x="366" y="418" width="160" height="52" rx="9"></rect>
      <text class="kt" x="378" y="438">Redis cache</text>
      <text class="ks" x="378" y="454">faq: answers · 1 h TTL</text>

      <rect class="kdb" x="546" y="418" width="158" height="52" rx="9"></rect>
      <text class="kt" x="558" y="438">stdout / LLM traces</text>
      <text class="ks" x="558" y="454">one JSON line per call</text>

      <!-- inbound → edge -->
      <path class="kl" d="M86,74 L86,120"></path>
      <path class="kl" d="M246,74 L246,120"></path>
      <path class="kla" d="M400,74 L400,120"></path>
      <path class="kla" d="M537,74 L537,120"></path>
      <path class="kl" d="M657,74 L657,120"></path>

      <!-- edge → domain -->
      <path class="kl" d="M86,174 L86,220"></path>
      <path class="kl" d="M246,174 C246,196 560,200 620,220"></path>
      <path class="kla" d="M400,174 L410,220"></path>
      <path class="kla" d="M520,174 C500,196 340,200 300,220"></path>
      <path class="kl" d="M657,174 L657,296"></path>

      <!-- domain internal -->
      <path class="kl" d="M86,282 L86,296"></path>
      <path class="kl" d="M180,282 C200,288 220,290 232,296"></path>
      <path class="kl" d="M260,282 C300,288 350,290 380,296"></path>
      <path class="kl" d="M430,282 C450,288 500,290 518,296"></path>
      <path class="kl" d="M620,282 L620,296"></path>

      <!-- domain → state -->
      <path class="kl flow-dash" d="M86,374 L86,416"></path>
      <path class="kl flow-dash" d="M238,374 L200,416"></path>
      <path class="kl flow-dash" d="M385,374 L320,416"></path>
      <path class="kl" d="M120,374 C130,392 400,400 440,416"></path>
      <text class="klab" x="150" y="398">cache read/write</text>
      <path class="kl" d="M140,374 C200,396 580,404 620,416"></path>
    </svg>
    <div class="figcap">
      Amber boxes are HTTP shells, 31 to 88 lines each, no business logic. Teal
      boxes are the domain: pure TypeScript that runs with zero secrets. Dashed
      edges carry state.
    </div>
  </div>

  <NerdBox title="what every route does before it delegates">
    <p>
      An HTTP route can only be exercised by constructing a request, faking a
      signature, and standing up an environment. A pure function can be
      exercised by calling it. So every route in the edge layer does exactly
      four things, then hands off:
    </p>
    <ol class="steps">
      <li>
        Read the raw body before any JSON parsing: the HMAC runs over raw bytes.
      </li>
      <li>
        Verify identity: HMAC signature, RSA decryption, or a Bearer secret.
      </li>
      <li>Parse and validate the payload shape against a strict schema.</li>
      <li>
        Hand the validated object to a domain function, and translate its result
        into a status code.
      </li>
    </ol>
  </NerdBox>
</div>
